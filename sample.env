# Copy to flatfinder.env and fill in as needed. Most values are OPTIONAL — the
# backend runs without them (OLX works with no creds). Telegram now needs the
# MTProto worker creds below to return results.

# Background auto-refresh interval in minutes (default 60). Set DISABLE_SCHEDULER=1 to turn it off.
REFRESH_MINUTES=60
# DISABLE_SCHEDULER=1

# Reddit source — create a "script" app at https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=nodejs:flat-finder:1.0 (by /u/yourusername)

# Threads source — Graph API token from developers.facebook.com (owned account only)
# THREADS_ACCESS_TOKEN=

# Telegram MTProto worker — reads public-channel history via a real user account
# (not IP-throttled like the t.me/s web preview). api_id/api_hash from
# https://my.telegram.org/apps. Generate TG_SESSION once with:
#   cd telegram-worker && npm install && \
#     TG_API_ID=... TG_API_HASH=... npm run login
# TG_SESSION grants full account access — keep it secret, never commit it.
# TG_API_ID=
# TG_API_HASH=
# TG_SESSION=
