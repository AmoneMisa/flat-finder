# Copy to flatfinder.env and fill in as needed. Most values are OPTIONAL — the
# backend runs without them (OLX works with no creds). Telegram now needs the
# MTProto worker creds below to return results.

# Background auto-refresh interval in minutes (default 60). Set DISABLE_SCHEDULER=1 to turn it off.
REFRESH_MINUTES=60
# DISABLE_SCHEDULER=1

# Shared AI enrichment worker. Keep this key server-side and set it to the same
# value as AI_API_KEY in ~/opt/ai-worker/ai-worker.env.
AI_WORKER_KEY=
# Optional safety tuning. Feed enrichment stays asynchronous. Interactive
# translation only waits for this short control-plane request; Ollama generation
# continues in ai-worker and is polled separately.
AI_WORKER_APARTMENT_BATCH=5
AI_WORKER_MAX_PENDING=60
AI_WORKER_SUBMIT_CONCURRENCY=4
AI_WORKER_REQUEST_TIMEOUT_MS=10000
AI_WORKER_POLL_MS=5000

# Telegram MTProto worker — reads public-channel history via a real user account
# (not IP-throttled like the t.me/s web preview). api_id/api_hash from
# https://my.telegram.org/apps. Generate TG_SESSION once with:
#   cd telegram-worker && npm install && \
#     TG_API_ID=... TG_API_HASH=... npm run login
# TG_SESSION grants full account access — keep it secret, never commit it.
# Public/private URL of the separately deployed Telegram worker.
# TG_WORKER_URL=https://your-telegram-worker.example.com
# TG_API_ID=
# TG_API_HASH=
# TG_SESSION=
# Optional proxy for hosts that block direct egress to Telegram's datacenters
# (a plain TCP connect to 149.154.x / 91.108.x times out). Route the worker
# through a SOCKS5 proxy or a Telegram MTProxy that CAN reach Telegram.
# Leave unset for a direct connection.
#   SOCKS5:  set HOST/PORT (and USER/PASS if the proxy needs auth)
#   MTProxy: set HOST/PORT and SECRET
# TG_PROXY_HOST=
# TG_PROXY_PORT=
# TG_PROXY_USER=
# TG_PROXY_PASS=
# TG_PROXY_SECRET=

POSTGRES_DB=flatfinder
POSTGRES_USER=flatfinder
POSTGRES_PASSWORD=CHANGE_ME_TO_LONG_RANDOM_PASSWORD
