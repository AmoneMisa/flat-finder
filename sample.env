# Copy to flatfinder.env and fill in as needed. Most values are OPTIONAL — the
# backend runs without them (OLX works with no creds). Telegram now needs the
# MTProto worker creds below to return results.

# Background auto-refresh interval in minutes (default 60). Set DISABLE_SCHEDULER=1 to turn it off.
REFRESH_MINUTES=60
# DISABLE_SCHEDULER=1

# Internal server-to-server key used by queue/worker tooling. Use a long random
# value in production; never expose it to the browser or mobile app.
QUEUE_INTERNAL_KEY=
# Optional dedicated key for /internal/db-stats and /internal/refresh. When
# empty, the backend falls back to QUEUE_INTERNAL_KEY.
# OPS_INTERNAL_KEY=

# Shared AI enrichment worker. Keep this key server-side and set it to the same
# value as AI_API_KEY in ~/opt/ai-worker/ai-worker.env.
AI_WORKER_KEY=
# Text enrichment stays asynchronous.
AI_WORKER_APARTMENT_BATCH=5
AI_WORKER_MAX_PENDING=60
AI_WORKER_SUBMIT_CONCURRENCY=4
AI_WORKER_REQUEST_TIMEOUT_MS=10000
AI_WORKER_POLL_MS=5000

# Background photo enrichment. Only a small batch is scheduled after each
# country refresh; ai-worker caches unchanged photo sets for 30 days, so hourly
# refreshes do not repeatedly consume provider quotas.
AI_WORKER_VISION_BATCH=3
AI_WORKER_VISION_CONCURRENCY=1
AI_WORKER_VISION_MAX_PENDING=30
AI_WORKER_VISION_TIMEOUT_MS=150000

# Exact-photo anti-fake check. Runs locally without Groq/Cloudflare: the backend
# downloads each selected image, hashes its exact bytes and stores the hash in
# Postgres so the same image can be detected across listings/cities/countries.
ANTIFAKE_IMAGE_TIMEOUT_MS=8000
ANTIFAKE_MAX_IMAGE_BYTES=8388608

# Telegram MTProto worker — reads public-channel history via a real user account
# (not IP-throttled like the t.me/s web preview). api_id/api_hash from
# https://my.telegram.org/apps. Generate TG_SESSION once with:
#   cd telegram-worker && npm install && \
#     TG_API_ID=... TG_API_HASH=... npm run login
# TG_SESSION grants full account access — keep it secret, never commit it.
# Public/private URL of the separately deployed Telegram worker.
# TG_WORKER_URL=https://your-telegram-worker.example.com
# TG_API_ID=
# TG_API_HASH=
# TG_SESSION=
# Optional proxy for hosts that block direct egress to Telegram's datacenters
# (a plain TCP connect to 149.154.x / 91.108.x times out). Route the worker
# through a SOCKS5 proxy or a Telegram MTProxy that CAN reach Telegram.
# Leave unset for a direct connection.
#   SOCKS5:  set HOST/PORT (and USER/PASS if the proxy needs auth)
#   MTProxy: set HOST/PORT and SECRET
# TG_PROXY_HOST=
# TG_PROXY_PORT=
# TG_PROXY_USER=
# TG_PROXY_PASS=
# TG_PROXY_SECRET=

# Public social fetcher (Facebook / Threads / LinkedIn). It deliberately does
# not accept account cookies or login/session credentials.
SOCIAL_MAX_ITEMS=100
SOCIAL_HTTP_TIMEOUT=30
SOCIAL_BROWSER_TIMEOUT_MS=45000
SOCIAL_BROWSER_CONCURRENCY=1
THREADS_SCROLLS=8
LINKEDIN_MAX_DETAIL_FETCHES=15
SOCIAL_IMPERSONATE=chrome124
# Housing social discovery is deliberately rotated because Threads uses one
# serialized Chromium session. All configured cities/Ukraine oblasts are walked
# over successive cycles rather than hammering every query at once.
SOCIAL_HOUSING_SOURCE=on
SOCIAL_HOUSING_REFRESH_MINUTES=30
SOCIAL_HOUSING_THREADS_QUERIES_PER_CYCLE=12
SOCIAL_HOUSING_LIMIT=40
SOCIAL_HOUSING_TIMEOUT_MS=150000
# Optional separate key. When empty, backend uses QUEUE_INTERNAL_KEY.
# SOCIAL_INTERNAL_KEY=

POSTGRES_DB=flatfinder
POSTGRES_USER=flatfinder
POSTGRES_PASSWORD=CHANGE_ME_TO_LONG_RANDOM_PASSWORD
